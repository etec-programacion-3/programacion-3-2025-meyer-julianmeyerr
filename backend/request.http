### get all users
GET http://localhost:4000/api/users

###get one user
GET http://localhost:4000/api/users/68fa6fad596eadf8b2fb23d4

### Register user
POST http://localhost:4000/api/auth/register
Content-Type: application/json

{
    "name": "Bonaventura",
    "email": "bona@ejemplo.com",
    "password": "123456"
}

### Login user
POST http://localhost:4000/api/auth/login
Content-Type: application/json

{
    "email": "bona@ejemplo.com",
    "password": "123456"
}

### Get current user profile
GET http://localhost:4000/api/profile/me
Authorization: Bearer {{token}}

### Create a new product
POST http://localhost:4000/api/products
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Producto 12",
    "description": "Este es un producto de prueba nuevo",
    "price": 100,
    "stock": 50
}
### delete a product
DELETE http://localhost:4000/api/products/68f8f16eb10d3877e7609e59
Authorization: Bearer {{token}}

### get all products
GET http://localhost:4000/api/products

### get product by id
GET http://localhost:4000/api/products/68fa6efe596eadf8b2fb23c1

### get my products
GET http://localhost:4000/api/products/mine
Authorization: Bearer {{token}}

### create conversation
POST http://localhost:4000/api/conversations
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "productId": "68fa6f03596eadf8b2fb23c4"
}

### get my conversations
GET http://localhost:4000/api/conversations/mine
Authorization: Bearer {{token}}

### get conversations
GET http://localhost:4000/api/conversations

### create message
POST http://localhost:4000/api/messages
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "conversationId": "68fb8e2ad42295423927663b",
    "content": "Hola, sigo la conversacion."
}

### get all messages
GET http://localhost:4000/api/messages

### get messages by conversation id
GET http://localhost:4000/api/conversations/68fb8e2ad42295423927663b
Authorization: Bearer {{token}}